  );
  const baseLinks = currentLinks.filter(l =>
    l.linkType !== 'expanded'
  );

  // Then add new expandedNodes and their links
  const newNodes = [...baseNodes, ...expandedNodes];
  const newLinks = [...baseLinks, ...expandedLinks];

  simulation.nodes(newNodes);
  simulation.force('link').links(newLinks);
  simulation.alpha(0.4).restart();

