Add prop: onSelectionChange: fn // ADDED

When selectedHop1 changes, call: // ADDED
  
  useEffect(() => {
    if (!selectedHop1) {
      onSelectionChange(null);
      return;
    }
    const children = allNodes.filter(n =>
      n.hops === 2 &&
      n.samplePath?.includes(selectedHop1)
    );
    onSelectionChange({
      label: `Apps linked through ${selectedHop1}`,
      parentName: selectedHop1,
      nodes: children.length > 0 
        ? children 
        : allNodes.filter(n => n.name === selectedHop1)
    });
  }, [selectedHop1, allNodes]);

